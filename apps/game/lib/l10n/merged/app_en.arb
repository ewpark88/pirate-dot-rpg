  "battleStoryTraitReflect1B": "Strike when the shield drops!",
  "battleStoryTraitReflect2A": "Mirror shield, up!",
  "battleStoryTraitReflect2B": "Hold fire a moment, then hit.",
  "battleStoryTraitEnrage1A": "The lower my health, the stronger I get!",
  "battleStoryTraitEnrage1B": "Finish it before it gets mad!",
  "battleStoryTraitEnrage2A": "I'm mad! Really mad!",
  "battleStoryTraitEnrage2B": "Brace the hull.",
  "battleStoryTraitEscort1A": "Minions, come out!",
  "battleStoryTraitEscort1B": "Sweep the escorts first!",
