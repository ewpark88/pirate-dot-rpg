  "battleStoryBossGhostAdmiralA": "My ghost fleet never stops coming...",
  "battleStoryBossGhostAdmiralB": "Then we'll never stop sweeping.",
  "battleStoryBossSeaCrocA": "Weak hits just tickle! And I get scarier when I'm mad!",
  "battleStoryBossSeaCrocB": "Skip the small shots—hit it big!",
  "battleStoryBossMonsterWhaleA": "I heal right back! Come out, little ones!",
  "battleStoryBossMonsterWhaleB": "Clear the escorts—don't give it time to heal!",
  "battleStoryBossIceSlimeA": "Squishy... whatever you shave grows back.",
  "battleStoryBossIceSlimeB": "Then we'll carve big chunks at once.",
  "battleStoryBossLeviathanA": "My scales send your attacks right back!",
  "battleStoryBossLeviathanB": "Wait for the shield to drop, then strike!",
  "battleStoryBossKrakenTitanA": "The Titan Kraken is here! Guards, hold them!",
  "battleStoryBossKrakenTitanB": "Escorts first, then one big blow!",
  "battleStoryBossPoseidonA": "Kneel before the King of the Sea!",
  "battleStoryBossPoseidonB": "Forget the crown—give back the treasure!",
  "battleStoryTraitEvade1A": "Where are you aiming? I'm over here!",
  "battleStoryTraitEvade1B": "It can't dodge a big blast!",
  "battleStoryTraitEvade2A": "I'll dodge every cannonball!",
  "battleStoryTraitEvade2B": "Then we leave nowhere to dodge.",
  "battleStoryTraitArmor1A": "Weak attacks won't work on me!",
  "battleStoryTraitArmor1B": "One hard hit, then!",
  "battleStoryTraitArmor2A": "Toughest shell in the sea!",
  "battleStoryTraitArmor2B": "A big cannonball will crack it.",
  "battleStoryTraitRegen1A": "I heal in no time!",
  "battleStoryTraitRegen1B": "Don't give it time to heal!",
  "battleStoryTraitRegen2A": "Heh heh, healing up...",
  "battleStoryTraitRegen2B": "Pile on and finish it.",
