{
  "permissions": {
    "allow": [
      "Bash(dart run tool/check.dart*)",
      "Bash(dart run tool/gen_tables.dart*)",
      "Bash(dart run tool/merge_arb.dart*)",
      "Bash(dart run game_cli*)",
      "Bash(dart test*)",
      "Bash(dart analyze*)",
      "Bash(dart format*)",
      "Bash(flutter test*)",
      "Bash(flutter analyze*)",
      "Bash(flutter gen-l10n*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && dart run tool/hooks/pre_edit.dart",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && dart run tool/hooks/post_edit.dart",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && dart run tool/hooks/stop_check.dart",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
